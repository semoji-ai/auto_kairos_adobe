# auto_kairos Adobe — 환경 설정 예시. 이 파일을 `.env`로 복사해 값을 채운다.
# 앱은 이 파일을 backend/env.py가 읽는다(AUTO_KAIROS_ENV로 위치 지정, 없으면 리포 이웃 폴더 탐색).
# 전부 선택 사항 — 키가 없으면 해당 기능만 비활성(예: ElevenLabs 키 없으면 TTS는 macOS `say` 폴백).

# ── 음성(TTS) ──────────────────────────────────────────────
# ElevenLabs — 내레이션 생성 + 글자별 타임스탬프(연출 타이밍 동기). 없으면 `say` 폴백.
ELEVENLABS_API_KEY=

# ── 자료 이미지 검색(실사 씬) ───────────────────────────────
# Serper(google 이미지) — 실사 자료 검색 + 멀티모달 적합성 검사. 없으면 실사 검색 비활성.
SERPER_API_KEY=
# (선택) Pixabay — 대체 이미지 소스
PIXABAY_API_KEY=
# (선택) Naver 검색 API
NAVER_API_CLIENT_ID=
NAVER_API_CLIENT_SECRET=

# ── 차트(선택) ─────────────────────────────────────────────
# chartagent 디자인 명세서 생성 루트. 미설치면 차트 기능만 비활성(나머지 정상).
CHARTAGENT_ROOT=~/Projects/chartagent

# ── 실행 설정(선택 — 기본값으로 충분) ──────────────────────
# 오케스트레이터 LLM: claude(기본) 또는 codex
# AK_ORCHESTRATOR=claude
# claude 모델 지정(비우면 CLI 기본). 짧은 플래닝엔 빠른 모델 권장
# AK_CLAUDE_MODEL=
# 이미지 생성 동시성(codex-fleet). 기본 16, 최대 ~32
# AK_GEN_CONCURRENCY=16
# 백엔드 포트(기본 8765)
# AK_BACKEND_PORT=8765
# 프로젝트 저장 루트(기본: 리포/projects)
# AK_PROJECTS_ROOT=
